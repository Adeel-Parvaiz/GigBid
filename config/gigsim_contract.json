{
  "description": "GigBid project-owned GigSim REST API v1",
  "auth_header": "Authorization",
  "auth_scheme": "Bearer",
  "idempotency_header": "Idempotency-Key",
  "idempotent_writes_verified": true,
  "operations": {
    "search_jobs": {
      "method": "GET",
      "path": "/v1/jobs",
      "params": {
        "q": "$query",
        "limit": "$limit"
      },
      "response_pointer": "/jobs"
    },
    "get_job": {
      "method": "GET",
      "path": "/v1/jobs/{job_id}"
    },
    "get_client_history": {
      "method": "GET",
      "path": "/v1/clients/{client_id}"
    },
    "get_connects_balance": {
      "method": "GET",
      "path": "/v1/balance"
    },
    "create_proposal_draft": {
      "method": "POST",
      "path": "/v1/drafts",
      "json": {
        "proposal": "$payload",
        "key": "$idempotency_key",
        "preview": "$dry_run"
      }
    },
    "submit_proposal": {
      "method": "POST",
      "path": "/v1/drafts/{draft_id}/submit",
      "json": {
        "key": "$idempotency_key"
      }
    },
    "list_threads": {
      "method": "GET",
      "path": "/v1/threads",
      "response_pointer": "/threads"
    },
    "list_messages": {
      "method": "GET",
      "path": "/v1/threads/{thread_id}"
    },
    "send_message": {
      "method": "POST",
      "path": "/v1/threads/{thread_id}/messages",
      "json": {
        "text": "$text",
        "key": "$idempotency_key"
      }
    }
  }
}
