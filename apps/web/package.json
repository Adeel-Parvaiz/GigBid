{
  "name": "gigbid-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-vite.mjs --host 127.0.0.1 --port 3000",
    "build": "tsc -b && node scripts/run-vite.mjs build",
