{
 "create_proposal_draft": {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "input": {
   "$defs": {
    "ProposalInput": {
     "properties": {
      "bid_amount": {
       "exclusiveMinimum": 0,
       "maximum": 1000000,
       "title": "Bid Amount",
       "type": "number"
      },
      "cover_letter": {
       "maxLength": 5000,
       "minLength": 1,
       "title": "Cover Letter",
       "type": "string"
      },
      "currency": {
       "default": "USD",
       "pattern": "^[A-Z]{3}$",
       "title": "Currency",
       "type": "string"
      },
      "dry_run": {
       "default": false,
       "description": "If true, nothing is created; returns exactly what would be sent and its Connects cost",
       "title": "Dry Run",
       "type": "boolean"
      },
      "freelancer_id": {
       "anyOf": [
        {
         "description": "Opaque marketplace id",
         "pattern": "^[\\w.-]{1,64}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Freelancer Id"
      },
      "idempotency_key": {
       "description": "Idempotency key: a retry with the same key never repeats the action",
       "maxLength": 64,
       "minLength": 8,
       "title": "Idempotency Key",
       "type": "string"
      },
      "job_id": {
       "description": "Opaque marketplace id",
       "pattern": "^[\\w.-]{1,64}$",
       "title": "Job Id",
       "type": "string"
      },
      "screening_answers": {
       "default": [],
       "items": {
        "maxLength": 3000,
        "type": "string"
       },
       "maxItems": 20,
       "title": "Screening Answers",
       "type": "array"
      }
     },
     "required": [
      "job_id",
      "cover_letter",
      "bid_amount",
      "idempotency_key"
     ],
     "title": "ProposalInput",
     "type": "object"
    }
   },
   "properties": {
    "proposal": {
     "$ref": "#/$defs/ProposalInput"
    }
   },
   "required": [
    "proposal"
   ],
   "title": "create_proposal_draftArguments",
   "type": "object"
  },
  "output": {
   "additionalProperties": true,
   "properties": {
    "connects_cost": {
     "default": 0,
     "title": "Connects Cost",
     "type": "integer"
    },
    "draft_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Draft Id"
    },
    "dry_run": {
     "default": false,
     "title": "Dry Run",
     "type": "boolean"
    },
    "replayed": {
     "default": false,
     "title": "Replayed",
     "type": "boolean"
    },
    "status": {
     "default": "draft",
     "title": "Status",
     "type": "string"
    },
    "would_send": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Would Send"
    }
   },
   "title": "DraftOut",
   "type": "object"
  }
 },
