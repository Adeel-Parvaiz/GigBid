APP_SECRET_KEY=change_me_long_random
POSTGRES_PASSWORD=change_me
MARKETPLACE_MCP_TOKEN=change_me_long_random
PORTFOLIO_MCP_TOKEN=change_me_long_random  # internal API-to-portfolio MCP authentication
GIGSIM_API_TOKEN=change_me_long_random
MARKETPLACE_MODE=gigsim              # gigsim | sample   (live Upwork goes through its official MCP server, never scraping)
# Local shells: use python -m scripts.run_dataset to select the Kaggle corpus.
# Docker paths are relative to /app; build the corpus before building images.
GIGBID_DATA_DIR=data/processed/kaggle_2024_v1
# VPS profile only: managed PostgreSQL URL; replace with a rotated private value.
DATABASE_URL=postgresql://gigbid:change_me@db.example.invalid:5432/gigbid?sslmode=require
# VPS profile only: DNS name and callback registered with the OAuth provider.
DOMAIN=example.invalid
PUBLIC_UPWORK_CALLBACK_URL=https://example.invalid/api/connections/upwork/callback
REVIEWER_EMAIL=reviewer@gigbid.test
REVIEWER_PASSWORD=change_me
LLM_BACKEND=openai_compat            # heuristic = offline test double only
LLM_API_KEY=                         # Groq/OpenRouter/Together key if using a hosted open model; Ollama needs none
OPEN_LLM_BASE_URL=http://ollama:11434/v1
MODEL_PROFILE=open
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
CORS_ORIGINS=http://localhost:3000
# Live Upwork uses official MCP OAuth. Generate a persistent Fernet key for Compose:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_ENCRYPTION_KEY=
UPWORK_CALLBACK_URL=http://127.0.0.1:8000/connections/upwork/callback
# Live saved-search polling is off unless explicitly enabled with an interval >=15 minutes.
UPWORK_SCHEDULED_READS=0
# Postgres — your database connection
TEST_DATABASE_URL=postgresql://gigbid:change_me@localhost:5432/gigbid
TEST_DATABASE_URL_POOLED=